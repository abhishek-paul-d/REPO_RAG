# Copy to .env and fill in. Never commit .env.

# No paid LLM key is needed. Open-source answer model selection is deferred to Phase 7.
GITHUB_TOKEN=
# Only needed when REPO_RAG_EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=

# Optional overrides (defaults in src/repo_rag/config.py)
# REPO_RAG_DATA_DIR=data
# REPO_RAG_LLM_PROVIDER=local
# REPO_RAG_EMBEDDING_PROVIDER=huggingface   # default (Qwen3-Embedding-0.6B); or voyage
# REPO_RAG_MAX_CHUNK_CHARS=1500
# REPO_RAG_RERANK_CANDIDATE_DEPTH=50  # opt-in --rerank; 20 for the measured smaller pool
